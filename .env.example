# Copie para .env na máquina de produção e substitua somente por valores locais.
ARION_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=arion.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://arion.example.com
DJANGO_SECURE_HSTS_SECONDS=3600
ARION_WEB_PORT=8000

# Token público de navegador do Mapbox; não use aqui credenciais privadas.
MAPBOX_PUBLIC_TOKEN=
